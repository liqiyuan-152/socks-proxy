+type IPAllPrivateItem struct{}
+
+func NewIPAllPrivateItem() *IPAllPrivateItem {
+	return &IPAllPrivateItem{}
+}
+
+func (r *IPAllPrivateItem) Match(metadata *adapter.InboundContext) bool {
+	if metadata.DestinationAddressMatchFromResponse {
+		addresses := metadata.DNSResponseAddressesForMatch()
+		if len(addresses) == 0 {
+			return false
+		}
+		for _, destinationAddress := range addresses {
+			if N.IsPublicAddr(destinationAddress) {
+				return false
+			}
+		}
+		return true
+	}
+	if metadata.Destination.Addr.IsValid() {
+		return !N.IsPublicAddr(metadata.Destination.Addr)
+	}
+	if len(metadata.DestinationAddresses) == 0 {
+		return false
+	}
+	for _, destinationAddress := range metadata.DestinationAddresses {
+		if N.IsPublicAddr(destinationAddress) {
+			return false
+		}
+	}
+	return true
+}
+
+func (r *IPAllPrivateItem) String() string {
+	return "ip_all_private=true"
+}
