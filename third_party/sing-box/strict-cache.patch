+package cachefile
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/bbolt"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+)
+
+func strictCache(path string, strict bool) *CacheFile {
+	return New(context.Background(), log.NewNOPFactory().Logger(), option.CacheFileOptions{Path: path, StrictMode: strict, StoreFakeIP: true})
+}
+func TestStrictPreservesInvalidFiles(t *testing.T) {
+	for _, data := range [][]byte{{}, []byte("corrupted-test-database")} {
+		path := filepath.Join(t.TempDir(), "cache.db")
+		if err := os.WriteFile(path, data, 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := strictCache(path, true).start(); err == nil || !strings.Contains(err.Error(), "STRICT_CACHE_ERROR") {
+			t.Fatalf("expected strict failure: %v", err)
+		}
+		got, err := os.ReadFile(path)
+		if err != nil || !bytes.Equal(got, data) {
+			t.Fatalf("cache altered: %v", err)
+		}
+	}
+}
+func TestStrictFreshAndReopen(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "cache.db")
+	c := strictCache(path, true)
+	if err := c.start(); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.StoreMode("rule"); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	c = strictCache(path, true)
+	if err := c.start(); err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if got := c.LoadMode(); got != "rule" {
+		t.Fatalf("lost value: %s", got)
+	}
+}
+func TestLegacyStillResets(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "cache.db")
+	os.WriteFile(path, []byte("invalid"), 0600)
+	c := strictCache(path, false)
+	if err := c.start(); err != nil {
+		t.Fatal(err)
+	}
+	c.Close()
+}
+func TestStrictRuntimeStopsBeforeReset(t *testing.T) {
+	if path := os.Getenv("STRICT_CACHE_TEST_PATH"); path != "" {
+		c := strictCache(path, true)
+		if err := c.start(); err != nil {
+			panic(err)
+		}
+		snapshot, err := os.ReadFile(path)
+		if err != nil {
+			panic(err)
+		}
+		if err := os.WriteFile(path+".before", snapshot, 0600); err != nil {
+			panic(err)
+		}
+		fault := func(*bbolt.Tx) error { panic("injected database corruption") }
+		switch os.Getenv("STRICT_CACHE_TEST_OPERATION") {
+		case "view":
+			c.view(fault)
+		case "batch":
+			c.batch(fault)
+		case "update":
+			c.update(fault)
+		}
+		os.Exit(99)
+	}
+	for _, operation := range []string{"view", "batch", "update"} {
+		t.Run(operation, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "cache.db")
+			c := strictCache(path, true)
+			if err := c.start(); err != nil {
+				t.Fatal(err)
+			}
+			if err := c.StoreMode("retained"); err != nil {
+				t.Fatal(err)
+			}
+			c.Close()
+			cmd := exec.Command(os.Args[0], "-test.run=^TestStrictRuntimeStopsBeforeReset$")
+			cmd.Env = append(os.Environ(), "STRICT_CACHE_TEST_PATH="+path, "STRICT_CACHE_TEST_OPERATION="+operation)
+			output, err := cmd.CombinedOutput()
+			exit, ok := err.(*exec.ExitError)
+			if !ok || exit.ExitCode() != 78 || !bytes.Contains(output, []byte("STRICT_CACHE_ERROR")) {
+				t.Fatalf("wrong exit: %v %s", err, output)
+			}
+			before, err := os.ReadFile(path + ".before")
+			if err != nil {
+				t.Fatal(err)
+			}
+			after, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(before, after) {
+				t.Fatal("runtime reset modified database")
+			}
+		})
+	}
+}
