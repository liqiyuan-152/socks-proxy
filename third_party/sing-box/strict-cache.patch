+// Validate an existing database read-only: bbolt initializes empty files on
+// writable open, which would otherwise erase evidence of a truncated cache.
+func validateStrictCache(path string) (err error) {
+	info, err := os.Stat(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil // first use; the supervisor tracks previously initialized caches
+	}
+	if err != nil {
+		return err
+	}
+	if info.Size() == 0 {
+		return E.New("empty existing cache")
+	}
+	defer func() {
+		if recover() != nil {
+			err = E.New("cache integrity check panicked")
+		}
+	}()
+	db, err := bbolt.Open(path, 0o600, &bbolt.Options{ReadOnly: true, Timeout: time.Second})
+	if err != nil {
+		return err
+	}
+	defer db.Close()
+	return checkDatabase(db)
