@@ -0,0 +1,31 @@
+package rule
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+)
+
+func TestIPAllPrivate(t *testing.T) {
+	rule := NewIPAllPrivateItem()
+	tests := []struct {
+		name      string
+		addresses []netip.Addr
+		expected  bool
+	}{
+		{"empty", nil, false},
+		{"private-v4", []netip.Addr{netip.MustParseAddr("10.0.0.1")}, true},
+		{"private-v6", []netip.Addr{netip.MustParseAddr("fd00::1")}, true},
+		{"public", []netip.Addr{netip.MustParseAddr("203.0.113.10")}, false},
+		{"mixed", []netip.Addr{netip.MustParseAddr("10.0.0.1"), netip.MustParseAddr("203.0.113.10")}, false},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			metadata := &adapter.InboundContext{DestinationAddresses: test.addresses}
+			if actual := rule.Match(metadata); actual != test.expected {
+				t.Fatalf("expected %v, got %v", test.expected, actual)
+			}
+		})
+	}
+}
